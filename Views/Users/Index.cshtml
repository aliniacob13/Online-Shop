@{
    var emailSearch = ViewBag.EmailSearch as string ?? "";

    var roluriDisponibile = ViewBag.RoluriDisponibile as List<string> ?? new List<string> { "Admin", "Editor", "User" };
    var roluriSelectate = ViewBag.RoluriSelectate as List<string> ?? new List<string>();

    int lastPage = ViewBag.lastPage ?? 1;
    int currentPage = ViewBag.CurrentPage ?? 1;
    string paginationBaseUrl = ViewBag.PaginationBaseUrl as string ?? "/Users/Index?page=";
}

<style>
    .users-grid-card{
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 18px;
        background: #fff;
        transition: transform .15s ease, box-shadow .15s ease;
        height: 100%;
    }
    .users-grid-card:hover{
        transform: translateY(-2px);
        box-shadow: var(--apple-shadow);
    }

    .user-line{
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin: 0 0 10px 0;
    }
    .user-line i{
        color: rgba(0,0,0,.55);
        margin-top: 2px;
    }
    .user-label{
        color: var(--apple-muted);
        margin-right: 6px;
        white-space: nowrap;
    }

    .search-wrap{
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }
    .search-input{
        flex: 1 1 280px;
        min-width: 220px;
    }

    .sidebar-card{
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 18px;
        background: #fff;
    }
    .sidebar-title{
        font-weight: 700;
        margin-bottom: 12px;
        font-size: 1.05rem;
    }
    .sidebar-section{
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid rgba(0,0,0,.08);
    }
    .users-grid-card{
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 18px;
        background: #fff;
        transition: transform .15s ease, box-shadow .15s ease;
        height: 100%;
        overflow: hidden;
    }
    .users-grid-card .btn{
        max-width: 100%;
        white-space: normal;
    }
    .users-grid-card .btn{
        padding: .45rem .85rem !important;
        font-size: .92rem !important;
        line-height: 1.15 !important;
    }

    @@media (min-width: 576px){
    .users-grid-card .btn{
        white-space: nowrap !important;
    }
    }
    
</style>

<div class="apple-admin">
    <div class="container py-4 apple-wrap">

        <div class="mb-3">
            <h2 class="apple-title mb-1">Utilizatori</h2>
            <div class="apple-muted">Administrare utilizatori</div>
        </div>

        <div class="row g-3">

            <!-- SIDEBAR (stanga) -->
            <div class="col-12 col-lg-3">
                <div class="sidebar-card p-3 p-md-4">
                    <div class="sidebar-title">Filtrare</div>

                    <form method="get" asp-controller="Users" asp-action="Index" class="m-0">
                        <div class="sidebar-section pt-0 mt-0 border-0">
                            <div class="apple-muted mb-2" style="font-weight: 600;">Rol</div>

                            @foreach (var rol in roluriDisponibile)
                            {
                                bool bifat = roluriSelectate.Contains(rol);
                                <div class="form-check mb-1">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="roluriSelectate"
                                           value="@rol"
                                           id="rol_@rol"
                                           @(bifat ? "checked" : "") />
                                    <label class="form-check-label" for="rol_@rol">@rol</label>
                                </div>
                            }
                        </div>

                        <input type="hidden" name="email" value="@emailSearch" />
                        <input type="hidden" name="page" value="1" />

                        <div class="mt-3 d-grid gap-2">
                            <button type="submit" class="btn btn-apple pill px-4">Aplica</button>

                            <a class="btn btn-apple-outline pill px-4"
                               asp-controller="Users"
                               asp-action="Index">
                                Reset
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-12 col-lg-9">

                <div class="surface p-3 mb-3">
                    <form method="get" asp-controller="Users" asp-action="Index" class="m-0">
                        <div class="search-wrap">
                            <div class="search-input">
                                <input type="text"
                                       name="email"
                                       value="@emailSearch"
                                       class="form-control pill"
                                       placeholder="Cauta dupa email" />
                            </div>

                            @* pastram filtrele de rol cand cautam *@
                            @foreach (var rol in roluriSelectate)
                            {
                                <input type="hidden" name="roluriSelectate" value="@rol" />
                            }

                            <button type="submit" class="btn btn-apple pill px-4">
                                Cauta
                            </button>

                            <a class="btn btn-apple-outline pill px-4"
                               asp-controller="Users"
                               asp-action="Index">
                                Reset
                            </a>
                        </div>
                    </form>
                </div>

                <div class="row g-3">
                    @foreach (var user in ViewBag.UsersList)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="users-grid-card p-3 p-md-4 d-flex flex-column">

                                <div class="mb-3">
                                    <div class="fw-semibold" style="font-size: 1.05rem;">
                                        @user.UserName
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <p class="user-line">
                                        <i class="bi bi-person"></i>
                                        <span><span class="user-label">UserName:</span> @user.UserName</span>
                                    </p>

                                    <p class="user-line">
                                        <i class="bi bi-envelope"></i>
                                        <span><span class="user-label">Email:</span> @user.Email</span>
                                    </p>

                                    @if (user.FirstName != null)
                                    {
                                        <p class="user-line">
                                            <i class="bi bi-person"></i>
                                            <span><span class="user-label">Nume:</span> @user.FirstName</span>
                                        </p>
                                    }

                                    @if (user.LastName != null)
                                    {
                                        <p class="user-line">
                                            <i class="bi bi-person"></i>
                                            <span><span class="user-label">Prenume:</span> @user.LastName</span>
                                        </p>
                                    }
                                </div>

                                <div class="d-flex flex-column flex-sm-row gap-2 mt-auto w-100">
                                    <a asp-controller="Users"
                                       asp-action="Edit"
                                       asp-route-id="@user.Id"
                                       class="btn btn-apple pill px-4 w-100">
                                        Editare
                                    </a>

                                    <a asp-controller="Users"
                                       asp-action="Show"
                                       asp-route-id="@user.Id"
                                       class="btn btn-apple-outline pill px-4 w-100">
                                        Vizualizare
                                    </a>
                                </div>

                            </div>
                        </div>
                    }
                </div>

                <nav class="mt-4" aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@(paginationBaseUrl + (currentPage - 1))" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>

                        @for (int p = 1; p <= lastPage; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="@(paginationBaseUrl + p)">@p</a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= lastPage ? "disabled" : "")">
                            <a class="page-link" href="@(paginationBaseUrl + (currentPage + 1))" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>

            </div>
        </div>

    </div>
</div>