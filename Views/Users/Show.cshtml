@model OnlineShop.Models.ApplicationUser

<style>
    .user-show-wrap{ max-width: 900px; }

    .role-chip{
        display: inline-flex;
        align-items: center;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(0,0,0,.02);
        font-weight: 700;
        color: var(--apple-text);
        margin-right: 8px;
        margin-bottom: 8px;
    }

    .info-line{
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin: 0 0 10px 0;
    }
    .info-line i{
        color: rgba(0,0,0,.55);
        margin-top: 2px;
    }
    .info-label{
        color: var(--apple-muted);
        margin-right: 6px;
        white-space: nowrap;
    }
</style>

<div class="apple-admin">
    <div class="container py-4 user-show-wrap">

        <div class="mb-3">
            <h2 class="apple-title mb-1">Detalii utilizator</h2>
            <div class="apple-muted">Informații cont și roluri.</div>
        </div>

        <div class="surface p-3 p-md-4">

            <div class="mb-3">
                <p class="info-line">
                    <i class="bi bi-person"></i>
                    <span><span class="info-label">UserName:</span> <span class="fw-semibold">@Model.UserName</span></span>
                </p>

                <p class="info-line">
                    <i class="bi bi-envelope"></i>
                    <span><span class="info-label">Email:</span> <span class="fw-semibold">@Model.Email</span></span>
                </p>
            </div>

            @if (ViewBag.Roles.Count > 0)
            {
                <div class="mb-3">
                    <div class="fw-semibold mb-2">
                        <i class="bi bi-person"></i> Roluri utilizator:
                    </div>

                    <div class="d-flex flex-wrap">
                        @foreach (var role in ViewBag.Roles)
                        {
                            <span class="role-chip">@role</span>
                        }
                    </div>
                </div>
            }

            @if ((string)Model.Id != ViewBag.UserCurent.Id)
            {
                <div class="d-flex justify-content-end pt-2">
                    <form asp-controller="Users" asp-action="Delete" method="post" asp-route-id="@Model.Id">
                        <button type="submit" class="btn btn-danger pill px-4">
                            Sterge utilizator
                        </button>
                    </form>
                </div>
            }

        </div>

    </div>
</div>