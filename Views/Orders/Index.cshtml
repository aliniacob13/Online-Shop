@model IEnumerable<OnlineShop.Models.Order>

@{
    ViewData["Title"] = "Comenzile mele";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<h2 class="my-4 text-center fw-bold">Comenzile Mele</h2>

@if (!Model.Any())
{
    <div class="alert alert-info text-center fs-5">
        Nu ai plasat nicio comandă încă.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var order in Model)
        {
            var total = order.OrderItems.Sum(i => i.UnitPriceAtPurchase * i.Quantity);
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary px-3 py-2">Comanda #@order.Id</span>
                            <small class="text-muted">@order.OrderDate.ToString("dd MMM yyyy")</small>
                        </div>

                        <hr />

                        <h5 class="fw-bold mb-3">Produse</h5>

                        <ul class="list-unstyled">
                            @foreach (var item in order.OrderItems)
                            {
                                <li class="d-flex align-items-center mb-3">
                                    <img src="@item.ImageUrlAtPurchase"
                                         style="width: 60px; height: 60px; object-fit: cover; border-radius: 10px;"
                                         class="me-3" />

                                    <div>
                                        <div class="fw-semibold">@item.ProductTitleAtPurchase</div>
                                        <div class="text-muted small">
                                            @item.Quantity x @item.UnitPriceAtPurchase lei
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">Total:</span>
                            <span class="fw-bold fs-4 text-success">@total lei</span>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}
