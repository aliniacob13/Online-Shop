@model OnlineShop.Models.Product

@{
    ViewData["Title"] = "Adaugă Produs";
}

<style>
    :root{
        --apple-bg: #f5f5f7;
        --apple-surface: #ffffff;
        --apple-text: #1d1d1f;
        --apple-muted: #6e6e73;
        --apple-border: rgba(0,0,0,.10);
        --apple-blue: #0071e3;
        --apple-blue-hover: #0077ed;
        --apple-radius: 18px;
        --apple-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .apple-admin{
        background: var(--apple-bg);
        min-height: calc(100vh - 56px);
    }

    .apple-wrap{ max-width: 920px; }
    .apple-title{ letter-spacing: -0.02em; }
    .apple-muted{ color: var(--apple-muted); }
    .surface{
        background: var(--apple-surface);
        border: 1px solid var(--apple-border);
        border-radius: var(--apple-radius);
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }

    .pill{ border-radius: 999px; }

    .btn-apple{
        background: var(--apple-blue);
        border-color: var(--apple-blue);
        color: #fff;
    }
    .btn-apple:hover{
        background: var(--apple-blue-hover);
        border-color: var(--apple-blue-hover);
        color: #fff;
    }
    .btn-apple-outline{
        border-color: rgba(0,0,0,.18);
        color: var(--apple-text);
        background: #fff;
    }
    .btn-apple-outline:hover{
        background: rgba(0,0,0,.04);
        border-color: rgba(0,0,0,.22);
        color: var(--apple-text);
    }

    .form-label{
        font-weight: 600;
        color: var(--apple-text);
    }

    .form-control, .form-select{
        border-radius: 14px;
        border-color: rgba(0,0,0,.12);
        padding-top: .6rem;
        padding-bottom: .6rem;
    }
    .form-control:focus, .form-select:focus{
        border-color: rgba(0,113,227,.55);
        box-shadow: 0 0 0 .25rem rgba(0,113,227,.12);
    }

    .hint{
        font-size: .875rem;
        color: var(--apple-muted);
    }
</style>

<div class="apple-admin">
    <div class="container py-4 apple-wrap">

        <div class="mb-3">
            <h2 class="apple-title mb-1">Adaugă Produs Nou</h2>
            <div class="apple-muted">Completează detaliile produsului și încarcă o imagine.</div>
        </div>

        <div class="surface p-3 p-md-4">
            <form asp-action="Create" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Titlu Produs</label>
                    <input asp-for="Title" class="form-control" placeholder="Ex: iPhone 15 Pro" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Descriere</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Descriere scurtă, clară"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label">Preț (RON)</label>
                            <input asp-for="Price" type="number" min="0.01" step="0.01" class="form-control" placeholder="0.00"/>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="mb-3">
                            <label asp-for="Stock" class="form-label">Stoc</label>
                            <input asp-for="Stock" type="number" class="form-control" placeholder="0" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Categorie</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                        <option value="">-- Alege Categoria --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-2">
                    <label class="form-label">Imagine Produs</label>
                    <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.gif" />
                    <div class="hint mt-1">Recomandat: imagine clară, fundal simplu (alb), format .jpg/.png.</div>
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                    <input type="submit" value="Adaugă Produs" class="btn btn-apple pill px-4" />
                    <a asp-action="Index" class="btn btn-apple-outline pill px-4">Înapoi la listă</a>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}