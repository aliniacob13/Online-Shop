@model OnlineShop.Models.Product
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using System.Security.Claims
@using System.Linq

@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var canManageProduct = User.IsInRole("Admin") || Model.UserId == currentUserId;
    double? medie = ViewBag.AverageRating as double?;
    bool canReview = ViewBag.CanReview is bool b && b;
    var isAdmin = User.IsInRole("Admin");
    var isEditorOrUser = User.IsInRole("Editor") || User.IsInRole("User");
}

<style>
    :root{
        --apple-bg: #f5f5f7;
        --apple-surface: #ffffff;
        --apple-text: #1d1d1f;
        --apple-muted: #6e6e73;
        --apple-border: rgba(0,0,0,.10);
        --apple-blue: #0071e3;
        --apple-blue-hover: #0077ed;
        --apple-radius: 18px;
        --apple-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .apple-admin{
        background: var(--apple-bg);
        min-height: calc(100vh - 56px);
        padding-top: 14px;
        padding-bottom: 28px;
    }

    .apple-wrap{ max-width: 1100px; }
    .apple-title{ letter-spacing: -0.02em; }
    .apple-muted{ color: var(--apple-muted); }
    .surface{
        background: var(--apple-surface);
        border: 1px solid var(--apple-border);
        border-radius: var(--apple-radius);
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
    }

    .pill{ border-radius: 999px; }

    .btn-apple{
        background: var(--apple-blue);
        border-color: var(--apple-blue);
        color: #fff;
    }
    .btn-apple:hover{
        background: var(--apple-blue-hover);
        border-color: var(--apple-blue-hover);
        color: #fff;
    }
    .btn-apple-outline{
        border-color: rgba(0,0,0,.18);
        color: var(--apple-text);
        background: #fff;
    }
    .btn-apple-outline:hover{
        background: rgba(0,0,0,.04);
        border-color: rgba(0,0,0,.22);
        color: var(--apple-text);
    }

    .qty-input{
        width: 92px;
        border-radius: 14px;
        border-color: rgba(0,0,0,.12);
        padding-top: .55rem;
        padding-bottom: .55rem;
    }
    .qty-input:focus{
        border-color: rgba(0,113,227,.55);
        box-shadow: 0 0 0 .25rem rgba(0,113,227,.12);
    }

    .review-card{
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 18px;
        background: #fff;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .review-card:hover{
        transform: translateY(-2px);
        box-shadow: var(--apple-shadow);
    }

    .rating-chip{
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(0,0,0,.02);
        font-weight: 600;
    }

    .divider{
        border-top: 1px solid rgba(0,0,0,.06);
        margin: 14px 0;
    }

    /*Product Assistant*/
    .assistant-panel {
        position: fixed;
        right: 18px;
        bottom: 18px;
        width: 340px;
        max-width: calc(100vw - 36px);
        height: 420px;
        background: #fff;
        border: 1px solid rgba(0,0,0,.10);
        border-radius: 16px;
        box-shadow: 0 12px 40px rgba(0,0,0,.12);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        z-index: 1050;
    }
    .assistant-header {
        padding: 10px 12px;
        background: rgba(0,0,0,.03);
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }
    .assistant-messages {
        padding: 10px 12px;
        flex: 1;
        overflow: auto;
        font-size: 14px;
    }
    .assistant-bubble {
        padding: 8px 10px;
        border-radius: 12px;
        margin-bottom: 8px;
        max-width: 90%;
        white-space: pre-wrap;
        word-break: break-word;
    }
    .assistant-user { background: rgba(13,110,253,.10); margin-left: auto; }
    .assistant-ai { background: rgba(25,135,84,.10); }
    .assistant-footer {
        padding: 10px 12px;
        border-top: 1px solid rgba(0,0,0,.08);
        display: flex;
        gap: 8px;
    }
</style>

<div class="apple-admin">
    <div class="container apple-wrap">

        <div class="surface overflow-hidden">
            <div class="p-3 p-md-4">
                <partial name="ProdusInfo" model="Model"></partial>

                <div class="divider"></div>

                @* zona de cos si wishlist *@
                <div class="d-flex flex-column flex-sm-row gap-2">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <form asp-controller="Cart"
                              asp-action="Add"
                              method="post"
                              class="d-flex align-items-center gap-2 flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.Id" />

                            <input type="number"
                                   name="quantity"
                                   value="1"
                                   min="1"
                                   class="form-control qty-input"
                                   aria-label="Cantitate" />

                            <button type="submit" class="btn btn-success pill px-4">
                                Adaugă în coș
                            </button>
                        </form>

                        <form asp-controller="Wishlist"
                              asp-action="Add"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <button type="submit" class="btn btn-apple-outline pill px-4">
                                Adaugă la wishlist
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-success pill px-4"
                                data-bs-toggle="modal"
                                data-bs-target="#loginCartModal">
                            Adaugă în coș
                        </button>

                        <button type="button"
                                class="btn btn-apple-outline pill px-4"
                                data-bs-toggle="modal"
                                data-bs-target="#loginWishlistModal">
                            Adaugă la wishlist
                        </button>
                    }
                </div>

                @if (canManageProduct)
                {
                    <div class="divider"></div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2">
                        <a class="btn btn-apple pill px-4"
                           asp-controller="Products"
                           asp-action="Edit"
                           asp-route-id="@Model.Id">
                            Editează produs
                        </a>

                        <form asp-controller="Products"
                              asp-action="Delete"
                              asp-route-id="@Model.Id"
                              method="post"
                              onsubmit="return confirm('Ești sigur că vrei să ștergi acest produs?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger pill px-4">
                                Șterge produs
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        @* scorul mediu al produsului *@
        @{
            var ratingValues = Model.Reviews
                .Where(r => r.Rating.HasValue)
                .Select(r => r.Rating!.Value)
                .ToList();

            double? averageRating = ratingValues.Any() ? ratingValues.Average() : null;
        }

        @if (averageRating.HasValue)
        {
            <div class="surface p-3 mt-3">
                <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
                    <div class="fw-semibold">
                        Scor mediu al produsului:
                        <span class="rating-chip">
                            <span>★</span>
                            <span>@averageRating.Value.ToString("0.0")</span>
                            <span class="apple-muted">/ 5</span>
                        </span>
                    </div>
                    <div class="apple-muted">
                        (bazat pe @ratingValues.Count review-uri)
                    </div>
                </div>
            </div>
        }

        @*login pt cos/wishlist *@
        @if (User.Identity == null || !User.Identity.IsAuthenticated)
        {
            <div class="modal fade" id="loginCartModal" tabindex="-1" aria-labelledby="loginCartModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="loginCartModalLabel">Autentificare necesară</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Închide"></button>
                        </div>
                        <div class="modal-body">
                            Pentru a continua, autentifică-te sau creează un cont.
                        </div>
                        <div class="modal-footer">
                            <a class="btn btn-primary"
                               asp-area="Identity"
                               asp-page="/Account/Login"
                               asp-route-returnUrl="@Url.Action("AddAfterLogin", "Cart", new { productId = Model.Id, quantity = 1 })">
                                Login
                            </a>
                            <a class="btn btn-secondary"
                               asp-area="Identity"
                               asp-page="/Account/Register"
                               asp-route-returnUrl="@Url.Action("AddAfterLogin", "Cart", new { productId = Model.Id, quantity = 1 })">
                                Register
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="loginWishlistModal" tabindex="-1" aria-labelledby="loginWishlistModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="loginWishlistModalLabel">Autentificare necesară</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Închide"></button>
                        </div>
                        <div class="modal-body">
                            Pentru a continua, autentifică-te sau creează un cont.
                        </div>
                        <div class="modal-footer">
                            <a class="btn btn-primary"
                               asp-area="Identity"
                               asp-page="/Account/Login"
                               asp-route-returnUrl="@Url.Action("AddAfterLogin", "Wishlist", new { productId = Model.Id })">
                                Login
                            </a>
                            <a class="btn btn-secondary"
                               asp-area="Identity"
                               asp-page="/Account/Register"
                               asp-route-returnUrl="@Url.Action("AddAfterLogin", "Wishlist", new { productId = Model.Id })">
                                Register
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="mt-4"></div>

        @* afisare reviewuri *@
        <div id="reviews-container" class="mb-3">
            @foreach (var review in Model.Reviews)
            {
                <div class="container mb-3">
                    <div class="row">
                        <div class="col-md-8 offset-md-2">
                            <div class="review-card p-3 p-md-4">
                                @if (review.Rating.HasValue)
                                {
                                    <div class="mb-2">
                                        <span class="rating-chip">
                                            <span>★</span>
                                            <span>@review.Rating</span>
                                            <span class="apple-muted">/ 5</span>
                                        </span>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(review.Comment))
                                {
                                    <div class="mb-2">
                                        <div class="fw-semibold">Comentariu</div>
                                        <div>@review.Comment</div>
                                    </div>
                                }

                                <div class="apple-muted mb-3"><small>@review.DatePosted</small></div>

                                @{
                                    var isOwner = review.UserId == currentUserId;
                                }
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <div class="d-flex gap-2 flex-wrap">
                                        @if (isAdmin || (isEditorOrUser && isOwner))
                                        {
                                            <a class="btn btn-apple-outline btn-sm pill px-3"
                                               asp-controller="Reviews"
                                               asp-action="Edit"
                                               asp-route-id="@review.Id">
                                                <i class="bi bi-pencil-square"></i> Editează
                                            </a>
                                        }

                                        @if (isAdmin || (isEditorOrUser && isOwner))
                                        {
                                            <form method="post"
                                                  asp-controller="Reviews"
                                                  asp-action="Delete"
                                                  asp-route-id="@review.Id"
                                                  onsubmit="return confirm('Sigur vrei să ștergi acest review?');">
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-outline-danger btn-sm pill px-3" type="submit">
                                                    <i class="bi bi-trash"></i> Șterge
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* formular pt adaugare review *@
        @if (User.Identity != null && User.Identity.IsAuthenticated && canReview)
        {
            <div class="container mt-4" id="zona-review">
                <div class="row">
                    <div class="col-md-8 offset-md-2">
                        <div class="surface p-3 p-md-4">
                            <div class="fw-semibold mb-3">Adaugă un review</div>

                            <form method="post"
                                  id="review-form"
                                  asp-controller="Reviews"
                                  asp-action="Create">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="ProductId" value="@Model.Id" />

                                <div asp-validation-summary="All" class="text-danger mb-3 validation-summary"></div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Rating (1 - 5)</label>
                                    <select name="Rating" class="form-select">
                                        <option value="">Fără rating</option>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Comentariu</label>
                                    <textarea name="Comment"
                                              class="form-control"
                                              rows="3"></textarea>
                                </div>

                                <button type="submit" class="btn btn-success pill px-4">
                                    Adaugă review
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (User.Identity != null && User.Identity.IsAuthenticated && !canReview)
        {
            <div class="container mt-4">
                <div class="surface p-3">
                    Poți lăsa un review doar pentru produsele pe care le-ai achiziționat.
                </div>
            </div>
        }
        else
        {
            <div class="container mt-4">
                <div class="surface p-3">
                    Pentru a lăsa un review trebuie să te autentifici și să fi cumpărat acest produs.
                </div>
            </div>
        }

    </div>
</div>

@*Product Assistant*@
<div class="assistant-panel" id="assistantPanel">
    <div class="assistant-header">
        <span>Product Assistant</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="assistantToggle">Ascunde</button>
    </div>

    <div class="assistant-messages" id="assistantMessages">
        <div class="assistant-bubble assistant-ai">
            Pune o intrebare despre produs. Raspund din descriere si FAQ.
        </div>
    </div>

    <form class="assistant-footer" id="assistantForm" method="post">
        @Html.AntiForgeryToken()
        <input type="text" class="form-control" id="assistantInput" placeholder="Ex: Are garantie?" />
        <button type="submit" class="btn btn-primary">Trimite</button>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        (function () {
            var panel = document.getElementById("assistantPanel");
            var btnToggle = document.getElementById("assistantToggle");
            var form = document.getElementById("assistantForm");
            var input = document.getElementById("assistantInput");
            var msgs = document.getElementById("assistantMessages");

            var ascuns = false;

            function adaugaMesaj(text, tip) {
                var div = document.createElement("div");
                div.className = "assistant-bubble " + (tip === "user" ? "assistant-user" : "assistant-ai");
                div.textContent = text;
                msgs.appendChild(div);
                msgs.scrollTop = msgs.scrollHeight;
            }

            btnToggle.addEventListener("click", function () {
                ascuns = !ascuns;
                if (ascuns) {
                    msgs.style.display = "none";
                    form.style.display = "none";
                    btnToggle.textContent = "Afiseaza";
                    panel.style.height = "52px";
                } else {
                    msgs.style.display = "";
                    form.style.display = "";
                    btnToggle.textContent = "Ascunde";
                    panel.style.height = "420px";
                }
            });

            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                var text = (input.value || "").trim();
                if (!text) return;

                adaugaMesaj(text, "user");
                input.value = "";

                var tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenEl ? tokenEl.value : "";

                try {
                    var resp = await fetch('@Url.Action("AskAssistant", "Products")', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                        },
                        body: new URLSearchParams({
                            "__RequestVerificationToken": token,
                            "productId": "@Model.Id",
                            "message": text
                        })
                    });

                    var data = await resp.json();
                    adaugaMesaj((data && data.answer) ? data.answer : "Momentan nu avem detalii despre acest aspect.", "ai");
                } catch (err) {
                    adaugaMesaj("Momentan nu avem detalii despre acest aspect.", "ai");
                }
            });
        })();
    </script>
}