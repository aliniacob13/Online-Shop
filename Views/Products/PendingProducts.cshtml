@model IEnumerable<OnlineShop.Models.Product>

<div class="apple-admin">
    <div class="container py-4 apple-wrap">

        <div class="mb-3">
            <h2 class="apple-title mb-1">Produse în așteptare pentru aprobare</h2>
            <div class="apple-muted">Aprobă sau respinge produsele trimise de colaboratori.</div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="surface p-4 text-center apple-muted">
                Nu există produse în așteptare.
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-12">
                        <div class="pending-card p-3 p-md-4">

                            <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                                <div>
                                    <h4 class="mb-1">@item.Title</h4>
                                    <div class="small apple-muted">
                                        Status: <span class="badge bg-warning text-dark">In asteptare</span>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-3" />

                            <div class="meta">
                                <div><span class="apple-muted">Utilizator:</span> <span class="fw-semibold">@item.User?.UserName</span></div>
                                <div><span class="apple-muted">Categorie:</span> <span class="fw-semibold">@item.Category?.Name</span></div>
                                <div><span class="apple-muted">Stoc:</span> <span class="fw-semibold">@item.Stock</span></div>
                            </div>

                            <div class="mt-3">
                                <div class="apple-muted fw-semibold mb-1">Descriere</div>
                                <div>@item.Description</div>
                            </div>

                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <div class="mt-3">
                                    <div class="apple-muted fw-semibold mb-2">Imagine</div>
                                    <div class="img-frame">
                                        <img src="@item.ImageUrl" alt="@item.Title" />
                                    </div>
                                </div>
                            }

                            <form asp-action="Reject" method="post" class="mt-4">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />

                                <div class="d-flex flex-column flex-sm-row gap-2 mb-3">
                                    <button formaction="/Products/Approve"
                                            class="btn btn-success pill px-4">
                                        Approve
                                    </button>

                                    <button type="submit" class="btn btn-danger pill px-4">
                                        Reject
                                    </button>
                                </div>

                                <textarea name="feedback"
                                          class="form-control feedback w-100"
                                          placeholder="Scrie feedback pentru colaborator (optional)"></textarea>
                            </form>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>