@model IEnumerable<OnlineShop.Models.WishlistItem>

@{
    ViewData["Title"] = "Wishlist";
}

<style>
    .table-apple{
        margin: 0;
    }
    .table-apple thead th{
        font-weight: 600;
        border-bottom: 1px solid rgba(0,0,0,.08);
        padding-top: 14px;
        padding-bottom: 14px;
        background: transparent;
        white-space: nowrap;
    }
    .table-apple tbody td{
        border-top: 1px solid rgba(0,0,0,.06);
        vertical-align: middle;
        padding-top: 14px;
        padding-bottom: 14px;
    }
    .table-apple tbody tr:hover{
        background: rgba(0,0,0,.02);
    }

    .produs-cell{
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 240px;
    }
    .produs-img{
        width: 72px;
        height: 72px;
        object-fit: cover;
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,.08);
        background: #fff;
        flex: 0 0 auto;
    }
</style>

<div class="apple-admin">
    <div class="container py-4 apple-wrap">

        <div class="mb-3">
            <h2 class="apple-title mb-1">Wishlist-ul meu</h2>
        </div>

        @if (!Model.Any())
        {
            <div class="surface p-4 text-center apple-muted">
                Wishlist-ul meu este gol.
            </div>
        }
        else
        {
            <div class="surface p-2 p-md-3">
                <div class="table-responsive">
                    <table class="table table-apple align-middle">
                        <thead>
                            <tr>
                                <th>Produs</th>
                                <th>Pret</th>
                                <th class="text-end">Actiuni</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="produs-cell">
                                            <img src="@item.Product.ImageUrl"
                                                 alt="@item.Product.Title"
                                                 class="produs-img" />
                                            <div class="fw-semibold">@item.Product.Title</div>
                                        </div>
                                    </td>

                                    <td class="fw-semibold">@item.Product.Price.ToString("C")</td>

                                    <td class="text-end">
                                        <div class="d-inline-flex flex-wrap gap-2 justify-content-end">

                                            <form asp-action="MoveToCart" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-success btn-sm pill px-3">
                                                    Adauga in cos
                                                </button>
                                            </form>

                                            <form asp-action="Remove" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm pill px-3">
                                                    Sterge
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (TempData["message"] != null)
        {
            var type = TempData["messagetype"] ?? "alert-info";
            <div class="surface p-3 mt-3">
                <div class="alert @type mb-0">@TempData["message"]</div>
            </div>
        }

    </div>
</div>