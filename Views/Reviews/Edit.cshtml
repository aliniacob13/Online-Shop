@model OnlineShop.Models.Review

<style>
    .review-wrap{ max-width: 980px; }
    .hint{ font-size: .875rem; color: var(--apple-muted); }
</style>

<div class="apple-admin">
    <div class="container py-4 review-wrap">

        <div class="mb-3">
            <h2 class="apple-title mb-1">Editeaza review</h2>
            <div class="apple-muted">Actualizeaza ratingul si comentariul.</div>
        </div>

        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="surface p-3 p-md-4">

                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @*nu pierdem legatura cu produsul*@
                        <input type="hidden" asp-for="ProductId" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label">Rating (1 - 5)</label>
                            <select asp-for="Rating" class="form-select">
                                <option value="">Fara rating</option>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                            <div class="hint mt-1">Poti alege si fara rating.</div>
                            <span asp-validation-for="Rating" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Comment" class="form-label">Comentariu</label>
                            <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Scrie comentariul tau..."></textarea>
                            <span asp-validation-for="Comment" class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                            <button type="submit" class="btn btn-apple pill px-4">
                                Salveaza
                            </button>

                            <a class="btn btn-apple-outline pill px-4"
                               asp-controller="Products"
                               asp-action="Show"
                               asp-route-id="@Model.ProductId">
                                Inapoi la produs
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}