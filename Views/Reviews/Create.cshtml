@model OnlineShop.Models.Review

@{
    ViewData["Title"] = "Adaugă Review";
}

<style>
    .review-wrap{ max-width: 920px; }
    .hint{ font-size: .875rem; color: var(--apple-muted); }
</style>

<div class="apple-admin">
    <div class="container py-4 review-wrap">

        <div class="mb-3">
            <h2 class="apple-title mb-1">Adaugă Review Nou</h2>
            <div class="apple-muted">Spune-ți părerea și ajută alți cumpărători.</div>
        </div>

        <div class="surface p-3 p-md-4">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="ProductId" type="hidden" />

                @if (ViewBag.ProductName != null)
                {
                    <div class="mb-3">
                        <label class="form-label">Produs</label>
                        <input type="text"
                               class="form-control"
                               value="@ViewBag.ProductName"
                               disabled />
                        <div class="hint mt-1">Review-ul va fi asociat automat acestui produs.</div>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Comment" class="form-label">Conținut Review</label>
                    <textarea asp-for="Comment"
                              class="form-control"
                              rows="4"
                              placeholder="Scrie aici părerea ta despre produs..."></textarea>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Rating" class="form-label">Rating</label>
                    <input asp-for="Rating"
                           class="form-control"
                           type="number"
                           min="1"
                           max="5"
                           placeholder="Alege un rating între 1 și 5 (sau lasă gol)" />
                    <div class="hint mt-1">Poți lăsa doar comentariu, fără rating.</div>
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>

                @*trimitem data hidden *@
                <input asp-for="DatePosted" type="hidden" />

                <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                    <input type="submit" value="Salvează" class="btn btn-apple pill px-4" />

                    <a asp-controller="Products"
                       asp-action="Show"
                       asp-route-id="@Model.ProductId"
                       class="btn btn-apple-outline pill px-4">
                        Înapoi la produs
                    </a>
                </div>

            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}